#include <windows.h>
#include <winver.h>

#ifdef DEBUG
#define VER_FILEFLAGS                   VS_FF_DEBUG
#else
#define VER_FILEFLAGS                   VS_FF_PRERELEASE
#endif

#define VER_FILETYPE                    VFT_APP
#define VER_FILESUBTYPE                 VFT2_UNKNOWN
#define VER_FILEDESCRIPTION_STR         "@PROJECT_DESCRIPTION@\0"

#define VER_INTERNALNAME_STR            "ft2-clone\0"
#define VER_ORIGINALFILENAME_STR        "ft2-clone.exe\0"

#define VER_FILEVERSION                 1,0,0,0
#define VER_FILEVERSION_STR             "1.0.0.0\0"

#undef VER_PRODUCTNAME_STR
#define VER_PRODUCTNAME_STR             "@PROJECT_DESCRIPTION@\0"

#undef VER_PRODUCTVER
#define VER_PRODUCTVER                  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0

#undef VER_PRODUCTVER_STR
#define VER_PRODUCTVER_STR              "@PROJECT_VERSION_MAJOR@.@PROJECT_VERSION_MINOR@.@PROJECT_VERSION_PATCH@.0\0"

#undef VER_COMPANYNAME_STR
#define VER_COMPANYNAME_STR             "Olav ""8bitbubsy"" S\xF8rensen\0"

#undef VER_LEGALCOPYRIGHT_STR
#define VER_LEGALCOPYRIGHT_STR          "Copyright \xA9 2025 Olav ""8bitbubsy"" S\xF8rensen\0"

// ------- version info -------------------------------------------------------

VS_VERSION_INFO     VERSIONINFO
FILEVERSION         VER_FILEVERSION
PRODUCTVERSION      VER_PRODUCTVER
FILEFLAGSMASK       VS_FFI_FILEFLAGSMASK
FILEFLAGS           VER_FILEFLAGS
FILEOS              VOS_NT_WINDOWS32
FILETYPE            VER_FILETYPE
FILESUBTYPE         VER_FILESUBTYPE
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",                VER_COMPANYNAME_STR
            VALUE "FileDescription",            VER_FILEDESCRIPTION_STR
            VALUE "FileVersion",                VER_FILEVERSION_STR
            VALUE "InternalName",               VER_INTERNALNAME_STR
            VALUE "LegalCopyright",             VER_LEGALCOPYRIGHT_STR
            VALUE "OriginalFilename",           VER_ORIGINALFILENAME_STR
            VALUE "ProductName",                VER_PRODUCTNAME_STR
            VALUE "ProductVersion",             VER_PRODUCTVER_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252

    END
END

IDI_MAIN_ICON ICON "gfxdata\\icon\\ft2-clone.ico"